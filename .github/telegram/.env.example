# ─── TELEGRAM BOT CONFIGURATION ───────────────────────────────────────────────

# Telegram API ID & Hash (didapatkan dari https://my.telegram.org)
API_ID=123456
API_HASH=abcdef0123456789abcdef0123456789

# Token Bot Telegram (didapatkan dari @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ-abcdefg

# ID Chat target (Channel atau Group). 
# Tips: ID Channel biasanya diawali dengan "-100" (contoh: -1001234567890)
CHAT_ID=-1001234567890


# ─── OPTIONAL BUILD METADATA ──────────────────────────────────────────────────

# Versi aplikasi (opsional)
VERSION=1.8.0

# Daftar komit yang disertakan dalam rilis (opsional)
# Format: <sha> — <pesan komit> atau <sha> <pesan komit> per baris
COMMIT=abc1234 — Perbaikan bug pada DNS cache
def5678 — Menambahkan dukungan MTProto uploader di Go

# Daftar komit cherry-pick (opsional)
CHERRY_PICK_COMMIT=

# Tag rilis atau tag fitur tambahan (opsional)
TAGS=golang,sing-box,beta
